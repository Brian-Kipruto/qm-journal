---
// src/layouts/Experiment.astro
// MDX passes frontmatter through Astro.props.frontmatter
const { frontmatter } = Astro.props;
import SiteFooter from '../components/SiteFooter.astro';
import Backlinks from '../components/Backlinks.astro';
import { ClientRouter } from 'astro:transitions';
import EntryNavigation from '../components/EntryNavigation.astro';
const { title, subtitle, expNumber, date, tags } = frontmatter;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Exp. {expNumber} · {title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link 
    rel="stylesheet" 
    href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" 
  />
  <ClientRouter />
</head>
<body>

<div class="page">
  <main class="main" transition:name="page-content" transition:animate="page-turn">

    <div class="exp-header">
      <span><strong>Exp. {expNumber}</strong> &nbsp;·&nbsp; QM Journal</span>
      <span>{tags?.join(' · ')}</span>
    </div>

    <h1>{title}</h1>
    {subtitle && <p class="subtitle">{subtitle}</p>}

    <slot />

    {(() => {
      const slug = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');
      return <Backlinks slug={slug} />;
    })()}

    {(() => {
      const slug = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');
      return <EntryNavigation slug={slug} />;
    })()}

    <div transition:persist="site-footer">
  <SiteFooter lastUpdated={date} />
    </div>

  </main>
</div>

<style is:global>
  :root {
    --paper: #faf6ee;
    --ink: #1a1a1a;
    --ink-soft: #4a4a4a;
    --ink-faint: #8a8a8a;
    --rule: #d8d1c2;
    --psi: #2a4d8f;
    --rho: #993d3d;
    --accent-faint: #f0ead9;
    --serif: 'EB Garamond', Georgia, serif;
    --sans: 'Inter', system-ui, sans-serif;
    --mono: 'JetBrains Mono', 'Consolas', monospace;
  }

  * { box-sizing: border-box; }
  html, body { background: var(--paper); color: var(--ink); }
  body {
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.55;
    margin: 0;
    padding: 0;
  }

  /* Page is a single column with the main content centered. */
  /* Sidenotes use absolute positioning to float into right whitespace. */
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
    position: relative;
  }

  @media (min-width: 1100px) {
    .page {
      /* On wide screens, shift left to leave room for sidenotes on the right */
      max-width: 1100px;
      padding-right: 340px;  /* reserve right gutter for sidenotes */
    }
  }

  @media (max-width: 700px) {
    .page { padding: 2rem 1.25rem 4rem; }
  }

  .main { min-width: 0; }

  .exp-header {
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    padding: 0.75rem 0;
    margin-bottom: 2rem;
    font-family: var(--sans);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--ink-soft);
  }
  .exp-header strong { color: var(--ink); letter-spacing: 0.08em; }

  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 2.6rem;
    line-height: 1.15;
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }
  .subtitle {
    font-style: italic;
    color: var(--ink-soft);
    margin: 0 0 2.5rem;
    font-size: 1.1rem;
  }

  /* Section labels: ## headings in MDX become these */
  .main h2 {
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 2.5rem 0 0.75rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--rule);
    font-weight: 600;
  }

  .main p { margin: 0 0 1rem; }
  .main em { font-style: italic; }
  .main strong { font-weight: 600; }
  .main a { color: var(--psi); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 2px; }
  .main ul, .main ol { padding-left: 1.5rem; margin: 0 0 1rem; }
  .main li { margin: 0.25rem 0; }

  .footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink);
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--ink-faint);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  /* D3 plot styling — applied to dynamically created SVG elements */
  .axis path, .axis line { stroke: var(--ink-soft); stroke-width: 1; }
  .axis text { fill: var(--ink-soft); font-family: var(--mono); font-size: 10px; }
  .psi-line { fill: none; stroke: var(--psi); stroke-width: 1.5; }
  .rho-line { fill: none; stroke: var(--rho); stroke-width: 1.5; }
  .rho-fill { fill: var(--rho); opacity: 0.12; }
  .zero-line { stroke: var(--ink-faint); stroke-dasharray: 2,3; stroke-width: 0.75; }
  .box-wall { stroke: var(--ink); stroke-width: 2; }

  /* ===== Page-turn transition ===== */
  @keyframes page-turn-out {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0;
      transform: translateX(-16px);
    }
  }

  @keyframes page-turn-in {
    from {
      opacity: 0;
      transform: translateX(16px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  ::view-transition-old(page-content) {
    animation: page-turn-out 220ms cubic-bezier(0.4, 0.0, 0.6, 1) both;
  }

  ::view-transition-new(page-content) {
    animation: page-turn-in 320ms cubic-bezier(0.2, 0.0, 0.2, 1) 80ms both;
  }
</style>

</body>
</html>