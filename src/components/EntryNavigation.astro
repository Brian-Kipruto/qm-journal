---
import { entries } from '../content/entries.js';

const { slug } = Astro.props;

// Find this entry's index in the ordered entries array
const currentIndex = entries.findIndex((e) => e.slug === slug);
const previous = currentIndex > 0 ? entries[currentIndex - 1] : null;
const next = currentIndex < entries.length - 1 && currentIndex !== -1 ? entries[currentIndex + 1] : null;
---

<nav class="entry-nav" aria-label="Entry navigation">
  <div class="entry-nav-prev">
    {previous && (
      <a href={`/${previous.slug}`} class="nav-link nav-prev">
        <span class="nav-arrow">←</span>
        <span class="nav-meta">
          <span class="nav-label">Previous</span>
          <span class="nav-detail">
            <span class="nav-number">{previous.number}</span>
            <span class="nav-title">{previous.title}</span>
          </span>
        </span>
      </a>
    )}
  </div>

  <div class="entry-nav-home">
    <a href="/" class="nav-link nav-home">
      <span class="nav-arrow nav-arrow-up">↑</span>
      <span class="nav-label">All entries</span>
    </a>
  </div>

  <div class="entry-nav-next">
    {next && (
      <a href={`/${next.slug}`} class="nav-link nav-next">
        <span class="nav-meta">
          <span class="nav-label">Next</span>
          <span class="nav-detail">
            <span class="nav-number">{next.number}</span>
            <span class="nav-title">{next.title}</span>
          </span>
        </span>
        <span class="nav-arrow">→</span>
      </a>
    )}
  </div>
</nav>

<style>
  .entry-nav {
    margin: 3rem 0 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem 2rem;
    align-items: center;
  }

  @media (max-width: 700px) {
    .entry-nav {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 1.25rem 0;
    }
    .entry-nav-home { order: 3; }
  }

  .entry-nav-prev { justify-self: start; }
  .entry-nav-next { justify-self: end; text-align: right; }
  .entry-nav-home { justify-self: center; }

  @media (max-width: 700px) {
    .entry-nav-prev, .entry-nav-next, .entry-nav-home {
      justify-self: stretch;
      text-align: left;
    }
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.15s;
    font-family: var(--serif);
  }
  .nav-link:hover { color: var(--psi); }
  .nav-link:hover .nav-arrow { color: var(--psi); }

  .nav-next { flex-direction: row; }
  .nav-prev { flex-direction: row; }

  .nav-arrow {
    font-size: 1.4rem;
    color: var(--ink-faint);
    line-height: 1;
    transition: color 0.15s, transform 0.15s;
    flex-shrink: 0;
  }
  .nav-link:hover .nav-prev .nav-arrow,
  .nav-prev:hover .nav-arrow {
    transform: translateX(-3px);
  }
  .nav-next:hover .nav-arrow {
    transform: translateX(3px);
  }

  .nav-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .nav-prev .nav-meta { align-items: flex-start; }
  .nav-next .nav-meta { align-items: flex-end; }

  @media (max-width: 700px) {
    .nav-next .nav-meta { align-items: flex-start; }
  }

  .nav-label {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .nav-detail {
    display: flex;
    flex-direction: column;
    gap: 0;
    line-height: 1.3;
  }

  .nav-number {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .nav-title {
    font-family: var(--serif);
    font-size: 0.95rem;
    color: var(--ink);
    max-width: 240px;
  }

  .nav-home {
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  @media (max-width: 700px) {
    .nav-home {
      flex-direction: row;
      gap: 0.5rem;
    }
  }
</style>