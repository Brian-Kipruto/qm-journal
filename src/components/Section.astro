---
const { letter, title } = Astro.props;

// Generate a URL-safe slug from the title.
// "Rules of a valid wave function" → "rules-of-a-valid-wave-function"
const anchorId = title
  ? `section-${letter?.toLowerCase() || ''}-${title
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '')}`
  : null;
---

<div class="section-heading" id={anchorId}>
  <span class="section-highlight">{letter}. {title}</span>
</div>

<style>
  .section-heading {
    margin: 3rem 0 1rem;
    scroll-margin-top: 2rem;
  }
  .section-highlight {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--highlight-section-dark);
    background: linear-gradient(transparent 55%, var(--highlight-section) 55%);
    padding: 0 0.3em;
  }
</style>