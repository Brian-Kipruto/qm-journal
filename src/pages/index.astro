---
import SiteFooter from '../components/SiteFooter.astro';
import { ClientRouter } from 'astro:transitions';
import { entries } from '../content/entries.js';

const formatDate = (d) => new Date(d).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});

// Group entries by type. Lectures (foundational) vs Experiments (hands-on).
const lectures = entries.filter(e => e.slug.startsWith('lecture-'));
const experiments = entries.filter(e => e.slug.startsWith('exp-'));
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>QM Journal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <ClientRouter />
</head>
<body>
  <main transition:name="page-content" transition:animate="page-turn">

    <!-- ===== Hero ===== -->
    <header class="hero">
      <div class="hero-eyebrow">QM Journal</div>
      <h1>A working notebook for learning quantum mechanics by building it.</h1>
      <p class="hero-intro">
        These are my notes from learning quantum mechanics, written so I can drag sliders and watch the math respond. The physics runs in C++ compiled to WebAssembly. The prose is mine; the goal is to understand the material well enough to make it stand up to interaction. If they help you too, even better.
      </p>
    </header>

    <!-- ===== Entries ===== -->
    <section class="entries-section">
      <div class="section-header">
        <span class="section-label">Entries</span>
        <span class="section-count">{entries.length}</span>
      </div>

      {lectures.length > 0 && (
        <div class="track">
          <h2 class="track-heading">
            <span class="track-mark track-mark-lecture"></span>
            Foundations
          </h2>
          <p class="track-desc">Foundational concepts. Start here if you're new to QM.</p>
          <ol class="entry-list">
            {lectures.map((entry) => (
              <li>
                <a href={`/${entry.slug}`} class="entry-card">
                  <div class="entry-card-header">
                    <span class="entry-card-num">{entry.number}</span>
                    <time class="entry-card-date">{formatDate(entry.date)}</time>
                  </div>
                  <div class="entry-card-title">{entry.title}</div>
                  <p class="entry-card-desc">{entry.description}</p>
                  {entry.tags && entry.tags.length > 0 && (
                    <div class="entry-card-tags">
                      {entry.tags.map((tag) => (
                        <span class="entry-card-tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </a>
              </li>
            ))}
          </ol>
        </div>
      )}

      {experiments.length > 0 && (
        <div class="track">
          <h2 class="track-heading">
            <span class="track-mark track-mark-experiment"></span>
            Experiments
          </h2>
          <p class="track-desc">Hands-on systems with interactive widgets. Each experiment builds on the foundations.</p>
          <ol class="entry-list">
            {experiments.map((entry) => (
              <li>
                <a href={`/${entry.slug}`} class="entry-card">
                  <div class="entry-card-header">
                    <span class="entry-card-num">{entry.number}</span>
                    <time class="entry-card-date">{formatDate(entry.date)}</time>
                  </div>
                  <div class="entry-card-title">{entry.title}</div>
                  <p class="entry-card-desc">{entry.description}</p>
                  {entry.tags && entry.tags.length > 0 && (
                    <div class="entry-card-tags">
                      {entry.tags.map((tag) => (
                        <span class="entry-card-tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </a>
              </li>
            ))}
          </ol>
        </div>
      )}
    </section>

    <!-- ===== Reading order ===== -->
    <section class="reading-order">
      <div class="section-header">
        <span class="section-label">Reading order</span>
      </div>
      <p class="reading-intro">
        Entries are designed to be read in sequence, though each stands on its own. If you're new:
      </p>
      <ol class="reading-path">
        {entries.map((entry, i) => (
          <li>
            <span class="path-step">{i + 1}</span>
            <a href={`/${entry.slug}`} class="path-link">
              <span class="path-num">{entry.number}</span>
              <span class="path-title">{entry.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <!-- ===== About ===== -->
    <section class="about">
      <div class="section-header">
        <span class="section-label">About this project</span>
      </div>
      <p>
        Each entry pairs careful prose explanation with interactive widgets where the underlying math is computed in C++ compiled to WebAssembly. The widgets aren't decorative — they're the math, made tactile. Drag a slider; the physics in the browser runs the calculation; D3 draws the result.
      </p>
      <p>
        The journal is built with Astro and MDX, KaTeX for math typesetting, and a hand-built component library for the lab-notebook aesthetic. No frameworks beyond that. Everything is statically rendered and hosted on Vercel.
      </p>
      <p>
        Source is on <a href="https://github.com/Brian-Kipruto/qm-journal" target="_blank" rel="noopener">GitHub</a>. The journal is a work in progress and will grow as I work through more material.
      </p>
    </section>

  </main>

  <div class="footer-wrapper" transition:persist="site-footer">
    <SiteFooter />
  </div>

<style>
  :root {
    --paper: #faf6ee;
    --ink: #1a1a1a;
    --ink-soft: #4a4a4a;
    --ink-faint: #8a8a8a;
    --rule: #d8d1c2;
    --psi: #2a4d8f;
    --accent-faint: #f0ead9;
    --serif: 'EB Garamond', Georgia, serif;
    --sans: 'Inter', system-ui, sans-serif;
    --mono: 'JetBrains Mono', 'Consolas', monospace;
  }

  * { box-sizing: border-box; }
  html, body { background: var(--paper); color: var(--ink); }
  body {
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.6;
    margin: 0;
  }

  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 2rem 2rem;
  }

  @media (max-width: 700px) {
    main { padding: 2.5rem 1.25rem 2rem; }
  }

  /* ===== Hero ===== */
  .hero {
    margin-bottom: 4rem;
  }
  .hero-eyebrow {
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.75rem;
  }
  .hero h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 2.2rem;
    line-height: 1.2;
    margin: 0 0 1.5rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  @media (max-width: 700px) {
    .hero h1 { font-size: 1.7rem; }
  }
  .hero-intro {
    font-size: 1.05rem;
    color: var(--ink-soft);
    margin: 0;
    max-width: 60ch;
  }

  /* ===== Section structure ===== */
  .section-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .section-label {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 600;
  }
  .section-count {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  /* ===== Entries section ===== */
  .entries-section { margin-bottom: 4rem; }

  .track { margin-bottom: 2.5rem; }
  .track:last-child { margin-bottom: 0; }

  .track-heading {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.1rem;
    margin: 0 0 0.25rem;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .track-mark {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .track-mark-lecture { background: var(--ink); }
  .track-mark-experiment {
    background: transparent;
    border: 1.5px solid var(--ink);
  }
  .track-desc {
    font-style: italic;
    color: var(--ink-soft);
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
    padding-left: 1.2rem;
  }

  .entry-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .entry-card {
    display: block;
    padding: 1.25rem 1.4rem;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid var(--rule);
    background: #fcfaf4;
    border-radius: 3px;
    transition: border-color 0.15s, background 0.15s, transform 0.1s;
  }
  .entry-card:hover {
    border-color: var(--ink-soft);
    background: var(--accent-faint);
  }
  .entry-card:active { transform: translateY(1px); }

  .entry-card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.35rem;
  }
  .entry-card-num {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 600;
  }
  .entry-card-date {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
  }

  .entry-card-title {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.3;
    margin-bottom: 0.4rem;
    color: var(--ink);
  }
  .entry-card:hover .entry-card-title { color: var(--psi); }

  .entry-card-desc {
    font-style: italic;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.45;
    margin: 0 0 0.75rem;
  }

  .entry-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .entry-card-tag {
    font-family: var(--sans);
    font-size: 0.7rem;
    color: var(--ink-faint);
    background: transparent;
    border: 1px solid var(--rule);
    padding: 0.1rem 0.5rem;
    border-radius: 10px;
  }

  /* ===== Reading order ===== */
  .reading-order {
    margin-bottom: 4rem;
  }
  .reading-intro {
    color: var(--ink-soft);
    margin: 0 0 1.25rem;
    font-size: 1rem;
  }
  .reading-path {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .reading-path li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    position: relative;
  }
  .reading-path li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 0.95rem;
    top: 2.2rem;
    bottom: -0.6rem;
    width: 1px;
    background: var(--rule);
  }
  .path-step {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--ink-faint);
    background: var(--accent-faint);
    border: 1px solid var(--rule);
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    z-index: 1;
  }
  .path-link {
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    padding: 0.4rem 0;
  }
  .path-link:hover .path-title { color: var(--psi); }
  .path-num {
    font-family: var(--sans);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 600;
  }
  .path-title {
    font-family: var(--serif);
    font-size: 1rem;
    color: var(--ink);
    transition: color 0.15s;
  }

  /* ===== About ===== */
  .about {
    margin-bottom: 3rem;
  }
  .about p {
    color: var(--ink-soft);
    font-size: 1rem;
    margin: 0 0 1rem;
    max-width: 60ch;
  }
  .about p:last-child { margin-bottom: 0; }
  .about a {
    color: var(--psi);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  /* ===== Footer wrapper ===== */
  .footer-wrapper {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  @media (max-width: 700px) {
    .footer-wrapper { padding: 0 1.25rem; }
  }

  /* ===== Page-turn transition (same as layouts) ===== */
  @keyframes page-turn-out {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(-16px); }
  }
  @keyframes page-turn-in {
    from { opacity: 0; transform: translateX(16px); }
    to { opacity: 1; transform: translateX(0); }
  }
  ::view-transition-old(page-content) {
    animation: page-turn-out 220ms cubic-bezier(0.4, 0.0, 0.6, 1) both;
  }
  ::view-transition-new(page-content) {
    animation: page-turn-in 320ms cubic-bezier(0.2, 0.0, 0.2, 1) 80ms both;
  }
</style>

</body>
</html>